# Neko Drive: Librarian Configuration

# Server
PORT=3000
NODE_ENV=development

# For production, set NODE_ENV=production and the server will:
# - Listen on 0.0.0.0:PORT (accessible from network)
# - Serve the built client from ../client/dist
# - Exit if API_SECRET is missing

# Performance
IDLE_TIMEOUT=255

# How old a pending (never-finalized) upload must be before the sweep deletes
# it and its Discord chunks (milliseconds, default 24h)
# STALE_PENDING_MS=86400000

# Security (client must send this in 'Authorization' header)
API_SECRET=your_super_secret_api_key

# Discord Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_storage_channel_id
DISCORD_BACKUP_CHANNEL_ID=your_backup_channel_id_optional
