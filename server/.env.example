# Neko Drive: Librarian Configuration

# Server
PORT=3000
DEBUG=true
NODE_ENV=development

# Performance tuning
IDLE_TIMEOUT=255
MAX_FILE_SIZE=1073741824

# Security (Client must send this in 'Authorization' header, NOT as query param)
API_SECRET=your_super_secret_api_key

# Discord Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_storage_channel_id
DISCORD_BACKUP_CHANNEL_ID=your_backup_channel_id_optional
